# Copy to .env and edit. Never commit .env -- it's gitignored.
# On Serverless these same names go in the endpoint's Environment Variables panel
# instead, which is why everything is env-driven: no rebuild needed to change them.

# Any Hugging Face repo id, or a local path to pre-downloaded weights.
MODEL_ID=mistralai/Ministral-3-14B-Instruct-2512

# Share of GPU memory reserved up front for weights + KV cache. Lower if OOM.
MEM_FRACTION_STATIC=0.8

# Max prompt + completion tokens. Higher = more KV cache memory per request.
CONTEXT_LENGTH=4096

# "auto" follows the model config (bf16 for Qwen2.5). Use float16 on T4-era GPUs.
DTYPE=auto

# SGLang verbosity: error | warning | info | debug
SGLANG_LOG_LEVEL=info

# Serverless only: concurrent jobs allowed per worker. Higher = better GPU
# utilisation via continuous batching, until you run out of KV cache.
MAX_CONCURRENCY=4

# Only needed for gated/private models. Qwen2.5-0.5B-Instruct is public.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
